# ============================================================
# EVE
# Canonical EVE terminal palette
# ============================================================

# Deep blue-charcoal base.
# Inspired by the blue tone produced by the original
# Ghostty EVE presentation, but made into EVE's actual surface.
background = #18262D

# Primary EVE text.
foreground = #E9967A


# ------------------------------------------------------------
# ROW 1 — CORE EVE SPECTRUM
# ------------------------------------------------------------

palette = 0=#1B0A26
palette = 1=#FF0055
palette = 2=#DF00FF
palette = 3=#FF007F
palette = 4=#7000FF
palette = 5=#FF00FF
palette = 6=#B300FF
palette = 7=#E8D0FF


# ------------------------------------------------------------
# ROW 2 — SUPPORTING / BRIGHT SPECTRUM
# ------------------------------------------------------------

palette = 8=#3D145A
palette = 9=#FF3377
palette = 10=#E633FF
palette = 11=#FF3399
palette = 12=#8C33FF
palette = 13=#FF33FF
palette = 14=#00D4FF

# Gold occupies the old white slot.
# Neovim will use this for NOTE: and other deliberate emphasis.
palette = 15=#F2C94C


# ------------------------------------------------------------
# SELECTION
# ------------------------------------------------------------

selection-background = #8B444E

# Selected characters use EVE's pale lavender instead of white.
selection-foreground = #E8D0FF
